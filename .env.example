DATABASE_URL=postgresql://designo:designo_dev@localhost:5432/designo
# Use 127.0.0.1 instead of localhost so Windows resolves IPv4 and avoids the
# WSL relay (wslrelay.exe) squatting on ::1:6379, which resets connections.
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
API_PORT=3001
FRONTEND_URL=http://localhost:3000
# AI API Provider (Gemini or OpenAI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Low-latency chat provider (Groq) - primary for interview chat
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Alternatively OpenAI:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-mini

# Optional extra failover layer (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

